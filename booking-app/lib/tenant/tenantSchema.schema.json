{
  "$id": "https://booking-app/tenant-schema.json",
  "$ref": "#/definitions/SchemaContextType",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Attestation": {
      "properties": {
        "html": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "html"
      ],
      "type": "object"
    },
    "BookingDetailRole": {
      "description": "Staff roles that a booking detail feature can be scoped to.",
      "enum": [
        "PA",
        "LIAISON",
        "SERVICES",
        "ADMIN",
        "SUPER_ADMIN"
      ],
      "type": "string"
    },
    "ContextLabels": {
      "properties": {
        "admin": {
          "type": "string"
        },
        "reviewer": {
          "type": "string"
        },
        "services": {
          "type": "string"
        },
        "user": {
          "type": "string"
        },
        "worker": {
          "type": "string"
        }
      },
      "required": [
        "user",
        "worker",
        "reviewer",
        "services",
        "admin"
      ],
      "type": "object"
    },
    "DetailsModalConfig": {
      "description": "Booking detail modal configuration (Firestore `tenantSchema.detailsModal`). Separate from `form`, which configures the request form.",
      "properties": {
        "memoEditRoles": {
          "description": "Roles that can edit the Memo, scoped to page contexts the same way as `memoViewRoles`. `PUT /api/bookings/memo` enforces the same list.",
          "items": {
            "$ref": "#/definitions/BookingDetailRole"
          },
          "type": "array"
        },
        "memoViewRoles": {
          "description": "Roles that can read the Memo. Roles in `memoEditRoles` can always read it too. A role also unlocks its own page context (PA page, Liaison page, Services page, Admin page; SUPER_ADMIN uses the Admin page). The Firestore read routes enforce the same list.",
          "items": {
            "$ref": "#/definitions/BookingDetailRole"
          },
          "type": "array"
        },
        "showMemo": {
          "description": "Show the staff-only Memo section under WebCheckout, used to record e.g. work order confirmation numbers.",
          "type": "boolean"
        },
        "showWebCheckout": {
          "description": "Show the WebCheckout section and the cart number in the bookings table.",
          "type": "boolean"
        },
        "webCheckoutEditRoles": {
          "description": "Roles that can edit the cart number, scoped to page contexts the same way as `memoEditRoles`. `POST /api/updateWebcheckoutCart` enforces the same list.",
          "items": {
            "$ref": "#/definitions/BookingDetailRole"
          },
          "type": "array"
        },
        "webCheckoutViewRoles": {
          "description": "Roles that can see the WebCheckout section. Roles in `webCheckoutEditRoles` can always see it too. Scoped to page contexts the same way as `memoViewRoles`. On My Bookings the requester still sees an assigned cart read-only while `showWebCheckout` is on.",
          "items": {
            "$ref": "#/definitions/BookingDetailRole"
          },
          "type": "array"
        }
      },
      "required": [
        "showWebCheckout",
        "webCheckoutViewRoles",
        "webCheckoutEditRoles",
        "showMemo",
        "memoViewRoles",
        "memoEditRoles"
      ],
      "type": "object"
    },
    "EmailNotifications": {
      "properties": {
        "approvedUser": {
          "type": "string"
        },
        "approvedVIP": {
          "type": "string"
        },
        "approvedWalkIn": {
          "type": "string"
        },
        "canceled": {
          "type": "string"
        },
        "canceledLate": {
          "type": "string"
        },
        "checkedIn": {
          "type": "string"
        },
        "checkedOut": {
          "type": "string"
        },
