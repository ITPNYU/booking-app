        "name": {
          "type": "string"
        },
        "parentResourceId": {
          "description": "When set, this resource is an auxiliary (annex) space belonging to the parent resource. Annex resources are hidden from the top-level room list, cannot be booked standalone, and are offered as annex checkboxes under their parent; selecting one invites its calendar to the parent's event.",
          "type": "string"
        },
        "requestLimits": {
          "$ref": "#/definitions/RequestLimits",
          "description": "Limit how many requests a user can make per period for this resource. Convention: `-1` (or missing) means “unlimited”.\n\nShape: each period has only `admin`, `faculty`, `student` — counts include all booking origins."
        },
        "resourceId": {
          "type": "string"
        },
        "services": {
          "anyOf": [
            {
              "$ref": "#/definitions/ResourceServicesConfig"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "description": "Consolidated service config; legacy string[] coerced on read"
