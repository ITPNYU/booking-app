    "ResourceFormSectionConfig": {
      "description": "Service section config.\n- mode \"radio\" / \"select\": choice list via options (`select` normalizes to radio on migrate)\n- mode \"checkbox\": optional option checkboxes (not forced like radio)\n- mode \"static\": read-only HTML\n- mode \"hidden\": offered but not shown\n- omit mode + chartField (no options): yes/no switch\n- omit mode + description only (no options/chartField/toggle): treated as static on migrate\n- toggle: lock the yes/no switch (see ServiceToggle). For equipment, omitting   toggle keeps the legacy layout (details field always shown, no switch).\n- autoCloseout: when the booking reaches Service Closeout (after Cancel or   Check Out), an approved request for this service is closed out by the   system instead of waiting for a service user. Omitted/false keeps the   manual closeout. Any booked room with the flag set closes the service out.",
      "properties": {
        "autoCloseout": {
          "type": "boolean"
        },
        "chartField": {
          "$ref": "#/definitions/ResourceChartFieldConfig"
        },
        "defaultValue": {
          "type": "string"
        },
        "descriptionHtml": {
          "type": "string"
        },
        "detailsDescriptionHtml": {
          "type": "string"
        },
        "detailsLabel": {
          "type": "string"
        },
        "forceCleaning": {
          "type": "boolean"
        },
        "hideForUser": {
          "deprecated": "Prefer showInOrigin",
          "type": "boolean"
        },
        "hideForVIP": {
          "deprecated": "Prefer showInOrigin",
          "type": "boolean"
        },
        "hideForWalkIn": {
          "deprecated": "Prefer showInOrigin",
          "type": "boolean"
        },
        "label": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "radio",
            "select",
            "checkbox",
            "static",
            "hidden"
          ],
          "type": "string"
        },
        "options": {
          "items": {
            "$ref": "#/definitions/ResourceFormOption"
          },
          "type": "array"
        },
        "required": {
          "type": "boolean"
        },
        "showDetailsField": {
          "type": "boolean"
        },
        "showInOrigin": {
          "$ref": "#/definitions/ShowInOrigin"
        },
        "studentLoungeCheckbox": {
          "type": "boolean"
        },
        "toggle": {
          "$ref": "#/definitions/ServiceToggle"
        }
      },
      "type": "object"
    },
